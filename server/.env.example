# 《千古一局：暗合推演》大模型 API 密钥与服务端环境配置文件 (.env)
# 请在下方填入你的真实 API Key（支持 DeepSeek、OpenAI、Gemini OpenAI兼容端点或本地 vLLM/Ollama）
# 保存后，服务端 (role_agent.py / acting_solidifier.py / docker-compose.yml) 会自动读取并激活真实 AI 推演与 OOC 语义裁判

# 1. DeepSeek 官方接口（推荐：支持自动 Prefix Caching，成本最低）
DEEPSEEK_API_KEY=

# 2. 通用 OpenAI 兼容接口（若使用其他大模型，填此处并修改下方 BASE_URL 与 MODEL_NAME）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL_NAME=deepseek-chat

# 3. 持久化与运行时配置（Docker 部署时无需修改）
REDIS_URL=redis://chibi-redis:6379/0
LLM_TIMEOUT_SEC=8.0
